# ---------------------------------------------------------------- required --

# PostgreSQL connection string.
#
#   local      postgresql:///skybase
#   Neon       postgresql://USER:PASSWORD@HOST.neon.tech/skybase?sslmode=require
#              (Neon console -> your project -> Connection string -> Pooled)
#
# The app rewrites a postgres:// prefix to postgresql:// and appends
# sslmode=require for Neon hosts, so either form works.
DATABASE_URL=postgresql:///skybase

# Signs the login cookie. Any long random string; Render generates one.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-something-long-and-random

# Admin password used by init_db.py when it creates the operations account.
# This repository is public, so there is no usable default for a deployed
# database: init_db.py refuses to seed a remote host without this set.
ADMIN_PASSWORD=pick-something-long-for-production
# ADMIN_EMAIL=ops@skybase.in

# ---------------------------------------------------------------- optional --

# Port for `python app.py`. Render sets this itself.
PORT=5001
